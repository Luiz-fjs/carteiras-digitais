# === Banco de Dados ===
POSTGRES_DB=accesschain
POSTGRES_USER=accesschain
POSTGRES_PASSWORD=accesschain_dev
DATABASE_URL=postgresql://accesschain:accesschain_dev@localhost:5432/accesschain

# === pgAdmin ===
PGADMIN_EMAIL=admin@accesschain.local
PGADMIN_PASSWORD=admin

# === API ===
API_PORT=3000
JWT_SECRET=dev-secret-change-in-production

# === Criptografia de chaves privadas dos Issuers (AES-256) ===
ISSUER_KEY_ENCRYPTION_SECRET=32-bytes-hex-change-this-in-prod

# === Email (Ethereal — SMTP mock para desenvolvimento) ===
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
